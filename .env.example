# Example worker environment values.
# Copy values into the Windows user environment; transcriber-server does not load
# this file automatically.

TRANSCRIBE_PROXY_TOKEN=replace-with-a-long-random-token
TRANSCRIBE_SERVER_HOST=127.0.0.1
TRANSCRIBE_SERVER_PORT=8092
TRANSCRIBE_WORK_DIR=C:\TranscriberJobs
TRANSCRIBE_MAX_UPLOAD_BYTES=10737418240
TRANSCRIBE_MAX_WORKERS=1
TRANSCRIBE_JOB_TTL_SECONDS=86400
TRANSCRIBE_DEVICE=cuda
TRANSCRIBE_COMPUTE_TYPE=float16
